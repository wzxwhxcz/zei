# ===================
# 服务器配置
# ===================
PORT=8000

# ===================
# API 配置
# ===================
# API 端点地址
API_ENDPOINT=https://chat.z.ai/api/v2/chat/completions

# 认证令牌：登录管理后台 /admin 的"主密钥"
# 推荐设一个强密码。登录后台后可以创建任意数量的子 API Key 给客户端用
# 多个用逗号分隔
AUTH_TOKEN=sk-your-master-token

# Captcha Provider 地址（老路径）
# 仅在「Go 直连」路径用到：从这里取 captcha token 注入请求 body。
# ⚠️ 日常推荐用下面的 CAPTCHA_FULL_PROXY_URL（全代理），设了之后本项只在
#    /admin 概览的健康检查（ping /health）用到，不再参与请求。
# 保留它作为回退：去掉 CAPTCHA_FULL_PROXY_URL 即回退到此路径。
CAPTCHA_PROVIDER_URL=http://127.0.0.1:9876

# JSDOM 全链路 chat 代理（推荐）
# 指向同一个 captcha-provider 的 /v1/chat：整个请求在同一个 JSDOM window 内完成
# （拿 captcha + 建会话 + 发 completions），绕开跨进程环境不一致导致的 F019 verify_failed。
# 设了就走全代理（CAPTCHA_PROVIDER_URL 的取 token 路径不再生效）。
CAPTCHA_FULL_PROXY_URL=http://127.0.0.1:9876

# ===================
# 持久化后端（可选，不设=文件存储 data/）
# ===================
# MySQL 主数据库（设了就用 MySQL 存 token/API key/用量；不设用文件 data/）
# 表会自动创建。DSN 格式：user:pass@tcp(host:port)/dbname?parseTime=true
# DATABASE_URL=root:password@tcp(127.0.0.1:3306)/zai2api?parseTime=true

# Redis 缓存（可选，叠加层）：captcha token 缓存 + token 轮询指针 + 失败熔断
# 多实例共享；不可用时自动降级直连
# REDIS_URL=redis://127.0.0.1:6379/0

# Z.AI JWT Token (多账号轮换)
# 已废弃：建议用后台 /admin 添加，可动态增删
# BACKUP_TOKEN=

# ===================
# 功能配置
# ===================
# 调试日志
DEBUG_LOGGING=false

# 工具调用支持（GLM 模型对此不稳定，详见 README）
TOOL_SUPPORT=true

# 强制把 auto/未指定的 tool_choice 升级为 required
FORCE_TOOL_CHOICE_REQUIRED=false

# 请求失败时的重试次数（不含首次请求）
RETRY_COUNT=5

# 跳过认证令牌验证（开放访问，不推荐）
SKIP_AUTH_TOKEN=false

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# ===================
# 显示配置
# ===================
# 备注信息，在 / 端点显示
NOTE=
